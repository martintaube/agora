# Public Supabase project settings. Copy to .env.local for local development.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Canonical app origin used for OTP callbacks and QR links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional read-only preview without a running Supabase instance.
AGORA_DEMO_MODE=false
